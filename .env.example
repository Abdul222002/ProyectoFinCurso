# ==========================================
# ULTIMATE FANTASY LEGENDS - ENV TEMPLATE
# ==========================================
# Copia este archivo como .env y rellena los valores.
# NO subas el archivo .env real al repositorio.

# 1. BASE DE DATOS (MYSQL)
MYSQL_ROOT_PASSWORD=cambiame_por_password_segura
MYSQL_DATABASE=ultimate_fantasy_legends
MYSQL_USER=root
MYSQL_HOST=db
MYSQL_PORT=3306

# 2. SEGURIDAD Y JWT
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=tu_clave_secreta_de_al_menos_32_caracteres
ALGORITHM=HS256

# 3. APIS EXTERNAS
RESEND_API_KEY=tu_api_key_de_resend
SPORTMONKS_API_KEY=tu_api_key_de_sportmonks

# 4. CONFIGURACIÓN DE SERVIDOR / FRONTEND
FRONTEND_URL=http://localhost:3000
BYPASS_EMAIL_VERIFICATION=false
ENVIRONMENT=production

# 5. CONFIGURACIÓN DE EMAIL (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password_de_google
